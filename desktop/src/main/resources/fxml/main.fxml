<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.mllopes.gestor.ui.MainController"
            prefWidth="1000" prefHeight="640"
            styleClass="root">
    <top>
        <VBox styleClass="topbar">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label text="Gestor" styleClass="brand"/>
                <Label fx:id="versaoLabel" styleClass="brand-sub"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" styleClass="status"/>
                <Button text="Atualizar" onAction="#atualizar" styleClass="btn"/>
                <Button text="Nova" onAction="#novaTarefa" styleClass="btn-primary"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filters">
                <padding><Insets top="0" right="16" bottom="10" left="16"/></padding>
                <Label text="Filtros:" styleClass="filter-label"/>
                <ComboBox fx:id="filtroStatus" prefWidth="180"/>
                <ComboBox fx:id="filtroPrioridade" prefWidth="140"/>
                <TextField fx:id="filtroTexto" promptText="Buscar..." HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.65">
            <VBox>
                <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                <Label fx:id="hojeLabel" styleClass="section"/>
                <TableView fx:id="tabelaTarefas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Status" fx:id="colStatus" prefWidth="120"/>
                        <TableColumn text="Título" fx:id="colTitulo" prefWidth="320"/>
                        <TableColumn text="Prioridade" fx:id="colPrioridade" prefWidth="100"/>
                        <TableColumn text="Nível" fx:id="colNivel" prefWidth="110"/>
                        <TableColumn text="Vencimento" fx:id="colVencimento" prefWidth="160"/>
                        <TableColumn text="Atualizado" fx:id="colAtualizado" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox styleClass="sidebar">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label text="Detalhes" styleClass="section"/>
                <Label fx:id="detalheTitulo" wrapText="true" styleClass="detalhe-titulo"/>
                <Label fx:id="detalheMeta" wrapText="true" styleClass="detalhe-meta"/>
                <Separator/>
                <Label text="Cobrança contínua" styleClass="section-sub"/>
                <Label fx:id="detalheCobranca" wrapText="true" styleClass="detalhe-meta"/>
                <Separator/>
                <HBox spacing="8">
                    <Button text="Concluir" onAction="#concluirSelecionada" styleClass="btn-success" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="8">
                    <Button text="Adiar" onAction="#adiarSelecionada" styleClass="btn" HBox.hgrow="ALWAYS"/>
                    <Button text="Cancelar" onAction="#cancelarSelecionada" styleClass="btn-danger" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Region VBox.vgrow="ALWAYS"/>
                <Label text="ML Lopes Design · v0.1.0" styleClass="footer"/>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <HBox styleClass="bottombar">
            <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
            <Label fx:id="contadoresLabel" styleClass="footer"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="app.mllopes.gestor" styleClass="footer"/>
        </HBox>
    </bottom>
</BorderPane>
